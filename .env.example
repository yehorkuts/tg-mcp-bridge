# Copy to .env on the server and fill in real values there.
# This file holds placeholders only. Local runs and CI use it via ENV_FILE=.env.example.

# Public URL without a trailing slash, and the domain for Caddy.
BASE_URL=http://localhost:8000
DOMAIN=localhost

# Telegram bot (BotFather).
BOT_TOKEN=<bot-token>
BOT_USERNAME=ExampleBot
TG_WEBHOOK_SECRET=<webhook-secret>

# Owner's Telegram id: alerts, digest, admin commands.
ADMIN_TG_ID=

# Limits and digest.
DAILY_MESSAGE_LIMIT=200
DAILY_POLL_LIMIT=100
DIGEST_HOUR=9
TZ=Europe/Warsaw

# Storage.
DB_PATH=/data/db.sqlite

# OAuth.
ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,http://localhost:6274/oauth/callback
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000

LOG_LEVEL=INFO
